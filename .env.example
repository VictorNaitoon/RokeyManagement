# =============================================================================
# RoKey MANAGEMENT - .env.example
# Copiar a .env y completar los valores: cp .env.example .env
# docker compose lee automáticamente Management/.env
# NO commitear el .env real (está en .gitignore)
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (servicio "postgres" en docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_DB=rokey
POSTGRES_USER=rokey
POSTGRES_PASSWORD=rokey
# Puerto host para psql/pgAdmin/EF migrations fuera de docker
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend API (.NET 9)
# ---------------------------------------------------------------------------
# Development habilita Swagger y evita HttpsRedirection (ver Program.cs)
ASPNETCORE_ENVIRONMENT=Development
# Puerto host donde se expone la API (contenedor siempre 8080)
BACKEND_PORT=8080

# JWT - sobrescriben appsettings.json / appsettings.Development.json
# Generar una clave segura: openssl rand -base64 48
JWT_KEY=RoKeySuperSecretKey2026!@#$%^&*()
JWT_ISSUER=RoKeyAPI
JWT_AUDIENCE=RoKeyApp
JWT_EXPIRY_MINUTES=480

# ---------------------------------------------------------------------------
# Frontends (nginx escucha 8080 dentro del contenedor)
# ---------------------------------------------------------------------------
ADMIN_PORT=3000
CLIENT_PORT=3001

# VITE_API_URL solo si se quiere buildear el portal con API externa
# En docker-compose local no es necesario: admin-panel usa proxy /api -> backend:8080
# VITE_API_URL=http://localhost:8080
